<exceptions>
    <exception package="com.simoneluconi.gcgallery">
        <permission name="android.permission.READ_MEDIA_IMAGES" fixed="false" />
        <permission name="android.permission.ACCESS_MEDIA_LOCATION" fixed="false" />
        <!-- The Wi-Fi transfer's foreground notification (address and Stop) -->
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="false" />
        <!-- The Wi-Fi transfer's own network (local-only hotspot) when there is no Wi-Fi;
             declared neverForLocation -->
        <permission name="android.permission.NEARBY_WIFI_DEVICES" fixed="false" />
    </exception>
</exceptions>
