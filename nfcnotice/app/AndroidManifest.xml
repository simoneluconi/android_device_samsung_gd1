<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.simoneluconi.gcnfc"
    android:versionCode="1"
    android:versionName="1.0">

    <!--
        Android 13+ suppresses toasts from apps whose notifications are off
        ("Suppressing toast ... by user request"); nfc-field-notice grants
        this at every start
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false">

        <!--
            Only nfc-field-notice (uid system) sends this; DUMP keeps
            ordinary apps from popping the toast.
        -->
        <receiver
            android:name=".FieldReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.simoneluconi.gcnfc.FIELD" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
