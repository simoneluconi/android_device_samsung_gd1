<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!--
        Wi-Fi country code from where the camera is. The GC100 takes it from
        its SIM; the GC200 has no modem, and without Google services there
        is no geocoder, so Android had no country at all. Take it from the
        802.11d country element of nearby access points when telephony has
        none (Android's own rule: several APs, all agreeing).
    -->
    <bool translatable="false" name="config_wifiUpdateCountryCodeFromScanResultGeneric">true</bool>

    <!--
        No 5 GHz hotspot. The cameras are 2.4 GHz only: the kernel's bcmdhd
        registers no 5 GHz band (on both the GC100 and the GC200 a 5 GHz
        join fails at the 802.11 auth step, with Samsung's stock Wi-Fi stack
        too; docs/TODO.md), so the hotspot settings offer 2.4 GHz only.
    -->
    <bool translatable="false" name="config_wifiSoftap5ghzSupported">false</bool>
</resources>
