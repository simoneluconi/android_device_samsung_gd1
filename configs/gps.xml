<?xml version="1.0" encoding="utf-8"?>
<!--
     BCM4752 daemon configuration, from the GC100 stock /system/etc/gps_4752.xml.
     Changed: SensorsEnable="false" (the daemon's Android 4.1 sensor API is
     stubbed by libgpsd_shim), the certificate path, and the data and log
     paths (/data/vendor/gps instead of /data/gps).
-->
<glgps xmlns="http://www.glpals.com/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.glpals.com/glconfig.xsd" >
  <!--HAL Confguration  -->
  <hal
       acPortName="/dev/ttySAC1"
       lBaudRate="921600"
       gpioNStdbyPath="/sys/class/sec/gps/GPS_PWR_EN/value"
       gpioDelayMs="250"
       acNvStoDir="/data/vendor/gps/"
       FactoryTestFilePath="/data/vendor/gps/"

       Log="JAVA"
       acLogDirectory="/data/vendor/gps/log"

       TISEnabled="true"
       LPmode="false"
       cp-cold-start="false"
       cp-guard-time-sec="1"

       arp-supl-enable="true"
       arp-supl-cap-msb="true"
       arp-supl-cap-msa="true"
       arp-supl-cap-ecid="false"
       arp-supl-use-apn="false"
       acSuplServer="supl.google.com"
       SuplPort="7276"
       tlsCertPath="/vendor/etc/gps.cer"
       tlsEnable="false"
       ReAidingIntervalSec="1200"
       SuplUT1Seconds="20"
       SuplUT2Seconds="20"
       SuplUT3Seconds="20"
       SuplVersion="1"

       LbsEnable="true"
       LbsLocal="false"
       LbsServer="BCMLS2.glpals.com"
       LbsPort="7275"
       LbsSyncLto="false"
       SyncLto="true"
       ltoFileName="lto2.dat"
       acLtoDir="/data/vendor/gps/"
       LbsSyncLtoThresholdDays="1"
       LbsTAC="10101106"
       ctrlPipe="/data/vendor/gps/glgpsctrl"
       LbsWlanEnable="false"

       IgnoreJniTime="true"
       AssertEnabled="false"
       SensorsEnable="false"
       SensorsTimePeriodGyroMs="20"
       SensorsTimePeriodAcclMs="20"


   />

  <gll
       LogPriMask="LOG_INFO"
       LogFacMask="LOG_GLLIO | LOG_RAWDATA | LOG_DEVKF | LOG_GLLAPI | LOG_NMEA"
       FrqPlan="FRQ_PLAN_26MHZ_2PPM_26MHZ_300PPB"
       RfType="GL_RF_4752_BRCM_EXT_LNA"
       WarmStandbyTimeout1Seconds="10"
       WarmStandbyTimeout2Seconds="15"
  >
  </gll>

  <gll_features
       EnableLowPowerEls="false"
       EnableLowPowerPmm="true"
  />

</glgps>
