# Camera-first first-boot setup (see gd1-setup.sh). It lives in system_ext
# because it calls the framework's settings and pm commands.
service gd1_setup /system_ext/bin/gd1-setup.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:su:s0

on property:sys.boot_completed=1
    start gd1_setup
